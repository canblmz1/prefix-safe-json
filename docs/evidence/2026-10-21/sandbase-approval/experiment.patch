+import { z } from 'zod';
+
+// Test-only replacements at the existing admission seam, not runtime adapters.
+// No PSJ parser, validator or decision implementation is used by either path.
+export function nativeDeferredTools(tools: Record<string, any>) {
+  return Object.fromEntries(Object.entries(tools).map(([name, definition]) => {
+    const { execute, onInputStart, onInputDelta, onInputAvailable, needsApproval, ...rest } = definition;
+    void [execute, onInputStart, onInputDelta, onInputAvailable, needsApproval];
+    return [name, { ...rest, needsApproval: true }];
+  }));
+}
+
+export function nativeAdmission(mode: 'native' | 'native-check', schemas: Record<string, object> = {}) {
+  const raw = new Map<string, { name: string; text: string; ended: boolean }>();
+  const projected: any[] = [];
+  const consumed = new Set<string>();
+  const validators = mode === 'native-check' ? new Map(Object.entries(schemas).map(([name, schema]) =>
+    [name, z.fromJSONSchema(schema as Parameters<typeof z.fromJSONSchema>[0])])) : new Map();
+  let fault: string | undefined, finished = false;
+  let decisions: any[] = [];
+  return {
+    push(part: any) {
+      if (part.type === 'tool-call' && !part.invalid) projected.push(part);
+      if (mode === 'native') return; // SDK JSON/invalid-call handling stays active.
+      if (part.type === 'tool-input-start') {
+        if (!part.id || raw.has(part.id) || !part.toolName) fault ??= 'native_identity';
+        else raw.set(part.id, { name: part.toolName, text: '', ended: false });
+      } else if (part.type === 'tool-input-delta') {
+        const call = raw.get(part.id);
+        if (!call || call.ended || typeof part.delta !== 'string') fault ??= 'native_lifecycle';
+        else call.text += part.delta;
+      } else if (part.type === 'tool-input-end') {
+        const call = raw.get(part.id);
+        if (!call || call.ended) fault ??= 'native_lifecycle';
+        else call.ended = true;
+      } else if (part.type === 'finish-step' || part.type === 'finish') {
+        if (!['stop', 'tool-calls'].includes(part.finishReason)) fault ??= 'native_finish';
+        if (part.type === 'finish') finished = true;
+      } else if (part.type === 'error' || part.type === 'tool-error') fault ??= 'native_sdk_error';
+    },
+    finish() {
+      const ids = new Set<string>();
+      decisions = projected.map((call, index) => {
+        let reason = fault;
+        let value = call.input;
+        if (mode === 'native-check') {
+          const original = raw.get(call.toolCallId);
+          if (!finished) reason ??= 'native_finish';
+          if (!call.toolCallId || ids.has(call.toolCallId) || !original || original.name !== call.toolName) reason ??= 'native_identity';
+          if (!original?.ended) reason ??= 'native_lifecycle';
+          try { value = JSON.parse(original?.text ?? ''); } catch { reason ??= 'native_json'; }
+          const validator = validators.get(call.toolName);
+          if (!validator || !validator.safeParse(value).success) reason ??= 'native_schema';
+          // Validation output is deliberately ignored; persist the original value.
+        }
+        ids.add(call.toolCallId);
+        return { internalId: `local-${index}`, toolCallId: call.toolCallId, name: call.toolName,
+          action: reason ? 'reject' : 'execute', reason: reason ?? (mode === 'native' ? 'sdk_projection' : 'native_raw_valid'), value };
+      });
+      if (mode === 'native-check' && raw.size !== projected.length) {
+        decisions = decisions.map(item => ({ ...item, action: 'reject', reason: 'native_identity' }));
+      }
+      return { decisions };
+    },
+    takeDecision(id: string) {
+      const decision = decisions.find(item => item.internalId === id);
+      if (!decision || decision.action !== 'execute' || consumed.has(id)) return;
+      consumed.add(id);
+      return decision;
+    },
+    snapshot() { return decisions; },
+  };
+}
