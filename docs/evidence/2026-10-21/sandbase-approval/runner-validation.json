{
  "environment": "Windows 11 build 26200, Node 22.23.2, pnpm 10.33.1",
  "psjInstall": {
    "command": "pnpm install --frozen-lockfile --offline",
    "exit": 0,
    "manifestOrLockChanged": false
  },
  "lint": { "command": "pnpm run lint --max-warnings=0", "exit": 0 },
  "syntax": { "command": "node --check scripts/evaluate-sandbase-approval.mjs", "exit": 0 },
  "guards": {
    "outputInsideCheckoutRejectedBeforeMutation": true,
    "modifiedCheckoutRejectedWithoutReset": true
  },
  "lintAdjustment": "Explicit Node imports; the new plain-JS runner keeps all existing lint rules without consuming an inferred TypeScript project slot. Existing files and the default-project limit are unchanged."
}
