  "peerDependencies": {
    "ai": ">=7.0.77 <8",
    "@ai-sdk/openai-compatible": ">=3.0.0 <4",
    "prefix-safe-json": ">=0.6.0 <0.7"
  },
  "devDependencies": {
    "ai": "7.0.143",
    "@ai-sdk/openai-compatible": "3.0.71",
    "prefix-safe-json": "0.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
