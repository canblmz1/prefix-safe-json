{
  "name": "psj-regression",
  "version": "0.1.0",
  "private": true,
  "description": "Offline raw-stream regression checks through the installed AI SDK",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "engines": { "node": ">=22" },
  "bin": { "psj-regression": "./dist/cli.js" },
