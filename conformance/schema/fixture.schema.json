{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Tool Call Integrity conformance fixture",
  "type": "object",
  "required": ["schemaVersion", "profile", "id", "description", "provenance", "events", "expected"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "profile": {
      "type": "string",
      "const": "normalized-gate",
      "description": "What this fixture proves. \"normalized-gate\" tests the coordinator/execution-gate's response to an already-normalized NormalizedToolStreamEvent sequence - never raw provider-wire parsing or adapter-level detection. See docs/CONFORMANCE.md."
    },
    "id": { "type": "string", "pattern": "^C[0-9]+-[a-z0-9-]+$" },
    "description": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["classification"],
      "additionalProperties": false,
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["protocol-realistic", "sdk-representable", "synthetic-adversarial"]
        },
        "project": { "type": "string" },
        "reference": { "type": "string", "format": "uri" },
        "note": { "type": "string" }
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "sequence", "provider"],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "tool_call_start",
              "tool_call_identity",
              "tool_call_name_delta",
              "tool_call_arguments_delta",
              "tool_call_end",
              "provider_diagnostic",
              "provider_stream_end"
            ]
          },
          "sequence": { "type": "integer", "minimum": 1 },
          "provider": { "type": "string" },
          "callRef": {
            "type": "object",
            "required": ["sourceKey"],
            "properties": { "sourceKey": { "type": "string" } }
          }
        }
      }
    },
    "expected": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["action", "reason"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "toolIndex": { "type": "integer" },
          "action": { "type": "string", "enum": ["execute", "retry", "reject"] },
          "reason": {
            "type": "string",
            "enum": [
              "complete",
              "truncated",
              "stream_incomplete",
              "schema_invalid",
              "malformed",
              "resource_limit",
              "provider_error",
              "content_filtered",
              "sdk_execution_observed",
              "projection_only",
              "protocol_violation",
              "unknown"
            ]
          }
        }
      }
    },
    "toolSchemas": {
      "type": "object",
      "description": "Optional per-tool JSON Schema (draft-07), for fixtures exercising schema-validity outcomes."
    }
  }
}
