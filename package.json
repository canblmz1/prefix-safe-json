{
  "name": "prefix-safe-json",
  "version": "0.3.0",
  "description": "Fail-closed execution integrity for streamed LLM tool calls — reject truncated or unconfirmed arguments before side effects",
  "keywords": [
    "json",
    "streaming",
    "incremental",
    "llm",
    "ai-agents",
    "tool-calling",
    "tool-execution",
    "execution-safety",
    "function-calling",
    "json-repair",
    "json-parser"
  ],
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canblmz1/prefix-safe-json.git"
  },
  "homepage": "https://github.com/canblmz1/prefix-safe-json#readme",
  "bugs": {
    "url": "https://github.com/canblmz1/prefix-safe-json/issues"
  },
  "packageManager": "pnpm@10.33.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit/",
    "test:corpus": "vitest run test/corpus/",
    "test:invariants": "vitest run test/invariants/",
    "test:providers": "vitest run test/providers/",
    "test:coverage": "vitest run --coverage",
    "test:mutate": "stryker run",
    "test:fuzz": "vitest run test/fuzz/",
    "bench": "vitest bench --run",
    "validate-corpus": "tsx scripts/validate-corpus.ts",
    "clean": "rimraf dist coverage .vitest",
    "pack:check": "pnpm pack --dry-run",
    "example:anthropic": "node examples/anthropic-truncation-safety.mjs",
    "example:ai-sdk": "node examples/ai-sdk-execution-gate.mjs",
    "example:ai-sdk-guard": "node examples/ai-sdk-guard.mjs",
    "example:ai-sdk-safe-boundary": "node examples/ai-sdk-v7-safe-boundary.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/clarinet": "^0.12.3",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^3.2.6",
    "ai-v5": "npm:ai@5.0.244",
    "ai-v6": "npm:ai@6.0.264",
    "ai-v7": "npm:ai@7.0.77",
    "clarinet": "^0.12.6",
    "eslint": "^9.8.0",
    "fast-check": "^4.9.0",
    "jsonrepair": "^3.15.0",
    "partial-json": "^0.1.7",
    "rimraf": "^6.0.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.15.2",
      "vite": "^6.4.3",
      "nanoid": "^3.3.18",
      "undici": "^7.28.0"
    }
  }
}
