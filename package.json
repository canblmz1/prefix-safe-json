{
  "name": "@internal/incremental-tool-json",
  "version": "0.0.1-alpha.0",
  "private": true,
  "description": "Incremental LLM tool-call JSON parser and deterministic repair engine",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ test/ scripts/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit/",
    "test:corpus": "vitest run test/corpus/",
    "test:invariants": "vitest run test/invariants/",
    "test:providers": "vitest run test/providers/",
    "test:coverage": "vitest run --coverage",
    "test:mutate": "stryker run",
    "test:fuzz": "vitest run test/fuzz/",
    "bench": "vitest bench --run",
    "validate-corpus": "tsx scripts/validate-corpus.ts",
    "clean": "rimraf dist coverage .vitest",
    "pack:check": "pnpm pack --dry-run",
    "example:anthropic": "node examples/anthropic-truncation-safety.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/clarinet": "^0.12.3",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^2.1.9",
    "ajv": "^8.20.0",
    "clarinet": "^0.12.6",
    "eslint": "^9.8.0",
    "fast-check": "^4.9.0",
    "jsonrepair": "^3.15.0",
    "partial-json": "^0.1.7",
    "rimraf": "^6.0.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
