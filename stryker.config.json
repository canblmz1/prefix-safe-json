{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "reporters": [
    "progress",
    "clear-text",
    "html"
  ],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "break": 85.01
  },
  "mutate": [
    "src/parser.ts",
    "src/grammar/stack.ts",
    "src/grammar/frame.ts",
    "src/grammar/pointer.ts",
    "src/utf8/decoder.ts",
    "src/lexer/scanner.ts",
    "src/diagnostics/factory.ts",
    "src/gate/decide.ts",
    "src/gate/gate.ts",
    "src/providers/ai-sdk.ts",
    "src/coordinator/coordinator.ts",
    "src/guard/provider-guard.ts",
    "src/guard/ai-sdk-execution-lock.ts"
  ],
  "timeoutMS": 10000,
  "timeoutFactor": 2
}
